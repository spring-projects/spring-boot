# Connection Details Factories
org.springframework.boot.autoconfigure.service.connection.ConnectionDetailsFactory=\
org.springframework.boot.mail.docker.compose.MailpitDockerComposeConnectionDetailsFactory,\
org.springframework.boot.mail.testcontainers.MailpitContainerConnectionDetailsFactory

# Failure Analyzers
org.springframework.boot.diagnostics.FailureAnalyzer=\
org.springframework.boot.mail.autoconfigure.NoSuchMailSenderBeanFailureAnalyzer
