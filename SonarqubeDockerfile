FROM gradle:8.5-jdk17

RUN apt-get update && apt-get install -y curl git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN mkdir -p /scripts && \
    cat > /scripts/build-and-scan.sh << 'BASH_SCRIPT'
#!/bin/bash
set -e

echo "=========================================="
echo "🔍 SONARQUBE SCAN START (Skip Gradle Build)"
echo "=========================================="
gradle sonarqube \
  -Dsonar.host.url=${SONAR_HOST} \
  -Dsonar.login=${SONAR_TOKEN} \
  -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
  -Dsonar.sourceEncoding=UTF-8 \
  --no-daemon 2>&1

echo ""
echo "=========================================="
echo "✅ SCAN COMPLETED"
echo "=========================================="
BASH_SCRIPT

RUN chmod +x /scripts/build-and-scan.sh

ENTRYPOINT ["/scripts/build-and-scan.sh"]
